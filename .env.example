# Copy to .env and adjust. Values here are loaded automatically by myproject/settings.py;
# real environment variables take priority.

# --- AI shopping assistant ---------------------------------------------------
# auto: first cloud key found below, else a running local Ollama, else the rule-based assistant.
LLM_PROVIDER=auto
# Local model (Ollama). "mj-assistant" is created by `ollama create` from ollama/Modelfile.
# LLM_MODEL=mj-assistant
# Cloud providers (set one):
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=

# --- Email -------------------------------------------------------------------
# Without these, emails are printed to the server console.
# Gmail: your address and an App Password (Google Account → Security → 2-Step Verification → App passwords).
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=abcd efgh ijkl mnop
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# Who gets a "New order" email when a customer pays (comma separated).
# ORDER_ALERT_EMAILS=you@gmail.com
# Public address of the site for links in emails (Vercel sets its own).
# SITE_URL=https://your-site.vercel.app

# --- MongoDB (chats and feedback) ---------------------------------------------
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/
# MONGODB_DB=mj

# --- Django ------------------------------------------------------------------
# DJANGO_DEBUG=1
# DJANGO_SECRET_KEY=change-me
# DJANGO_ALLOWED_HOSTS=example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
# Postgres for production (e.g. Neon). Empty: SQLite (db.sqlite3).
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# STORE_THEME=mj
